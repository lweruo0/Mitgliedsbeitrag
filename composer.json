{
    "name": "lweruo0/admidio-plugin-mitgliedsbeitrag",
    "description": "Admidio-5-Plugin Mitgliedsbeitrag (BFV-Fassung): Beitragseinzug, Buchungshistorie, Arbeitsdienst",
    "type": "project",
    "license": "GPL-2.0-only",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
